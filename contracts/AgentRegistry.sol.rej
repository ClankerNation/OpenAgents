+    /// @notice Register multiple agents in a single transaction (max 50).
+    /// @param names Array of agent names (max 64 chars each).
+    /// @param endpoints Array of agent endpoints.
+    /// @return agentIds_ Array of registered agent IDs.
+    function batchRegister(
+        string[] calldata names,
+        string[] calldata endpoints
+    ) external payable returns (bytes32[] memory agentIds_) {
+        uint256 count = names.length;
+        require(count == endpoints.length, "Array length mismatch");
+        require(count > 0 && count <= 50, "Invalid batch size");
+        require(msg.value >= registrationFee * count, "Insufficient total fee");
+
+        agentIds_ = new bytes32[](count);
+
+        for (uint256 i = 0; i < count; i++) {
+            string memory name = names[i];
+            require(bytes(name).length > 0 && bytes(name).length <= 64, "Invalid name");
+
+            // Append loop index i to prevent collisions when registering
+            // multiple agents with the same name in the same block
+            bytes32 agentId = keccak256(abi.encodePacked(msg.sender, name, block.timestamp, i));
+            require(agents[agentId].registeredAt == 0, "Agent exists");
+
+            agents[agentId] = Agent({
+                owner: msg.sender,
+                name: name,
+                endpoint: endpoints[i],
+                reputation: 100,
+                tasksCompleted: 0,
+                registeredAt: block.timestamp,
+                active: true
+            });
+
+            ownerAgents[msg.sender].push(agentId);
+            agentIds.push(agentId);
+            agentIds_[i] = agentId;
+
+            emit AgentRegistered(agentId, msg.sender, name);
+        }
+    }
+
     function deactivateAgent(bytes32 agentId) external {
         require(agents[agentId].owner == msg.sender, "Not agent owner");
         agents[agentId].active = false;

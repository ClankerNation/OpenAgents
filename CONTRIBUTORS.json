import "@openzeppelin/contracts/access/Ownable.sol";

contract AgentRegistry is Ownable {
    struct Agent {
        address owner;
        string name;
        uint256 registeredAt;
        bool exists;
    }

    uint256 private _nextAgentId = 1;
    mapping(uint256 => Agent) public agents;
    mapping(address => uint256[]) public userAgents;

    event AgentRegistered(uint256 indexed agentId, address indexed owner, string name, uint256 timestamp);

    constructor() Ownable(msg.sender) {}

    /**
     * @notice Register a new agent with a deterministic, collision-free ID
     * @param name The name of the agent
     * @return agentId The unique ID assigned to the agent
     */
    function registerAgent(string calldata name) external returns (uint256 agentId) {
        require(bytes(name).length > 0, "Name cannot be empty");

        agentId = _nextAgentId;
        _nextAgentId++;

        require(!agents[agentId].exists, "Agent ID already exists");

        agents[agentId] = Agent({
            owner: msg.sender,
            name: name,
            registeredAt: block.timestamp,
            exists: true
        });

        userAgents[msg.sender].push(agentId);

        emit AgentRegistered(agentId, msg.sender, name, block.timestamp);
    }

    /**
     * @notice Get agent details by ID
     * @param agentId The ID of the agent
     * @return Agent struct
     */
    function getAgent(uint256 agentId) external view returns (Agent memory) {
        require(agents[agentId].exists, "Agent does not exist");
        return agents[agentId];
    }

    /**
     * @notice Get all agent IDs for a user
     * @param user The address of the user
     * @return uint256[] Array of agent IDs
     */
    function getUserAgents(address user) external view returns (uint256[] memory) {
        return userAgents[user];
    }

    /**
     * @notice Get the next available agent ID
     * @return uint256 The next agent ID
     */
    function getNextAgentId() external view returns (uint256) {
        return _nextAgentId;
    }
}
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": false,
    "skipLibCheck": true,
    "types": [
      "node",
      "mocha",
      "chai"
    ],
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "sdk/src/**/*.ts",
    "test/**/*.ts"
  ]
}